# Copy this file to .env and fill in values. NEVER commit .env.
# Clio Manage OAuth (Developer Portal → your app)
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REFRESH_TOKEN=

# Region root. US default. Do not add a trailing slash.
# EU: https://eu.app.clio.com
# CA: https://ca.app.clio.com
# AU: https://au.app.clio.com
CLIO_BASE_URL=https://app.clio.com

# Pin Clio API minor version
CLIO_API_VERSION=4.0.0

# Provider: clio (v1) or mycase (stub)
PROVIDER=clio

# stdio for Claude Desktop / Cursor local
# http for Railway / remote MCP
MCP_TRANSPORT=stdio

# Required when MCP_TRANSPORT=http
MCP_HTTP_API_KEY=

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=INFO
